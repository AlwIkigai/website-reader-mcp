MCP_API_KEY=change-me
APP_ENV=local
REQUEST_TIMEOUT_SECONDS=12
MAX_RESPONSE_CHARS=12000
MAX_HTML_BYTES=2000000
ALLOWED_SCHEMES=https,http

# Comma-separated allowlist of Host header values that may access /mcp.
# Leave empty to disable host validation (API key still required).
# Use * to allow any host, exact hosts (example.com), subdomain wildcards (*.example.com),
# or port wildcards for local dev (localhost:*).
MCP_ALLOWED_HOSTS=
# Optional comma-separated Origin header values for browser clients (only checked when set).
MCP_ALLOWED_ORIGINS=

# URL fetch cache (opt-in; disabled by default)
CACHE_ENABLED=false
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=100
# Required only when CACHE_BACKEND=redis (e.g. Upstash on Vercel)
REDIS_URL=

# Fetch rate limiting (opt-in; disabled by default)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_PER_MINUTE=15
RATE_LIMIT_PER_HOUR=120
# Uses REDIS_URL when RATE_LIMIT_BACKEND=redis

# SSRF protection: resolve hostnames and reject any that map to private/internal
# IPs, then pin the connection to the validated IP (blocks DNS rebinding).
SSRF_DNS_VALIDATION_ENABLED=true
# Low per-query timeout (seconds); resolvers are queried concurrently.
SSRF_DNS_TIMEOUT_SECONDS=2
# Comma-separated resolvers. "system" uses /etc/resolv.conf; others are public
# resolver IPs (Cloudflare, Google). Any resolver returning a blocked IP rejects.
SSRF_DNS_RESOLVERS=system,1.1.1.1,1.0.0.1,8.8.8.8,8.8.4.4

# Local dev server (scripts/dev.sh)
HOST=0.0.0.0
PORT=8001
DEV_HTTPS=true
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem
