MCP_API_KEY=change-me
APP_ENV=local
REQUEST_TIMEOUT_SECONDS=12
MAX_RESPONSE_CHARS=12000
MAX_HTML_BYTES=2000000
ALLOWED_SCHEMES=https,http
# Comma-separated domain allowlist. Use * to allow all domains, or *.example.com for subdomains.
# Leave empty to deny all domains (secure default).
ALLOWED_DOMAINS=*

# DNS rebinding protection for the MCP transport.
# Leave empty to disable host validation (recommended behind Vercel / a token-protected
# public endpoint, where deployment hostnames are dynamic).
# To enable, set a comma-separated list of allowed Host header values, e.g.:
#   MCP_ALLOWED_HOSTS=website-reader-mcp.vercel.app,localhost:*
MCP_ALLOWED_HOSTS=
# Optional comma-separated list of allowed Origin header values (only used when
# MCP_ALLOWED_HOSTS is set), e.g. MCP_ALLOWED_ORIGINS=https://website-reader-mcp.vercel.app
MCP_ALLOWED_ORIGINS=

# Local dev server (scripts/dev.sh)
HOST=0.0.0.0
PORT=8001
DEV_HTTPS=true
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem
